<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Default/test/dev profiles: console only (no Cloud Logging appender) -->
    <springProfile name="default,test,dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [trace=%X{trace_id:-}%X{traceId:-},span=%X{span_id:-}%X{spanId:-}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <logger name="com.fifteen02" level="DEBUG"/>
        <logger name="io.opentelemetry" level="INFO"/>
        <logger name="io.opentelemetry.exporter" level="WARN"/>
        <logger name="org.springframework" level="WARN"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Staging/production: console + Cloud Logging appender -->
    <springProfile name="staging,live">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [trace=%X{trace_id:-}%X{traceId:-},span=%X{span_id:-}%X{spanId:-}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <appender name="CLOUD" class="com.google.cloud.logging.logback.LoggingAppender">
            <resourceType>k8s_container</resourceType>
            <enhancers>com.google.cloud.logging.logback.OpenTelemetryTraceLoggingEnhancer</enhancers>
        </appender>


        <logger name="com.fifteen02" level="DEBUG"/>
        <logger name="io.opentelemetry" level="INFO"/>
        <logger name="io.opentelemetry.exporter" level="WARN"/>
        <logger name="org.springframework" level="WARN"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="CLOUD"/>
        </root>
    </springProfile>

</configuration>
